---
import NetworkDiagram from "../../components/NetworkDiagram.astro";

export const prerender = false;

const gistId = Astro.params.gistId ?? "";
const validGistId = /^[a-f0-9]{5,64}$/i.test(gistId);

if (!validGistId) {
    return new Response("Invalid GitHub Gist ID.", {
        status: 400,
        headers: { "Content-Type": "text/plain; charset=utf-8" },
    });
}

const capture = Astro.url.searchParams.get("capture") === "1";

function boundedNumber(
    name: string,
    fallback: number,
    minimum: number,
    maximum: number,
): number {
    const value = Number(Astro.url.searchParams.get(name));
    if (!Number.isFinite(value)) return fallback;
    return Math.min(maximum, Math.max(minimum, value));
}

const zoom = boundedNumber("zoom", 1, 0.25, 3);
const padding = boundedNumber("padding", capture ? 30 : 50, 0, 200);
const gistUrl = `https://gist.github.com/${gistId}`;
const canonicalUrl = new URL(`/network/${gistId}`, Astro.url.origin);
const imageUrl = new URL(`/network/${gistId}/image.png`, Astro.url.origin);
imageUrl.searchParams.set("w", "1200");
imageUrl.searchParams.set("h", "630");
---

<!doctype html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Interactive GNS3 network | LabForger</title>
    <meta
        name="description"
        content="An interactive GNS3 network topology rendered by LabForger."
    />
    <link rel="canonical" href={canonicalUrl.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Interactive GNS3 network" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={imageUrl.href} />
    {capture && <meta name="robots" content="noindex, nofollow" />}
</head>
<body data-capture={capture ? "true" : "false"}>
    {!capture && (
        <header class="viewer-header">
            <a href="/" class="viewer-brand">LabForger</a>
            <div class="viewer-actions">
                <a href={gistUrl} rel="noreferrer">View source Gist</a>
                <a href={imageUrl.href}>Open static image</a>
            </div>
        </header>
    )}

    <main>
        <NetworkDiagram
            id="fullscreen-network"
            src={gistUrl}
            height={capture ? "100dvh" : "calc(100dvh - 3.5rem)"}
            toolbar={!capture}
            interactive={!capture}
            initialZoom={zoom}
            fitPadding={padding}
            capture={capture}
        />
    </main>
</body>
</html>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(html),
    :global(body) {
        width: 100%;
        min-width: 0;
        height: 100%;
        margin: 0;
    }

    :global(body) {
        overflow: hidden;
        background: #0f172a;
        color: #f8fafc;
        font-family:
            Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
            "Segoe UI", sans-serif;
    }

    .viewer-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        height: 3.5rem;
        padding: 0 1rem;
        border-bottom: 1px solid rgb(148 163 184 / 25%);
        background: #111827;
    }

    .viewer-brand {
        color: inherit;
        font-weight: 750;
        text-decoration: none;
    }

    .viewer-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.875rem;
    }

    .viewer-actions a {
        color: #bfdbfe;
    }

    main {
        width: 100%;
        height: 100%;
    }

    :global(body[data-capture="true"] main) {
        height: 100dvh;
    }

    :global(body[data-capture="true"] .network-diagram),
    :global(body[data-capture="true"] .network-diagram__body) {
        width: 100%;
        height: 100dvh;
        max-height: none;
    }

    @media (max-width: 650px) {
        .viewer-actions a:first-child {
            display: none;
        }
    }
</style>
